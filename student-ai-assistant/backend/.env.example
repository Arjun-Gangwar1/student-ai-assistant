# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in real values.  NEVER put real secrets in this file.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (docker compose up db):
DATABASE_URL=postgresql://studentai:studentai@localhost:5432/studentai
# Supabase production — Project Settings → Database → Connection string (URI):
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── LLM Providers ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq                     # groq | deepinfra
GROQ_API_KEY=gsk_replace-me
GEMINI_API_KEY=replace-me             # optional, multimodal (Phase 2)
DEEPINFRA_API_KEY=                    # optional fallback provider

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Create via @BotFather → /newbot
TELEGRAM_BOT_TOKEN=000000000:replace-me
TELEGRAM_WEBHOOK_SECRET=generate-with-  python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development                   # development | production
# Signs session cookies. Generate:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=replace-me
# Encrypts Google OAuth tokens at rest (Fernet).  Generate:
#   python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-me
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Feature flags ─────────────────────────────────────────────────────────────
# Gmail uses a RESTRICTED scope. Enabling it for real users requires Google OAuth
# verification + an annual CASA security assessment. See docs/PRIVACY.md.
GMAIL_ENABLED=true
# Comma-separated emails. If non-empty, Gmail sync runs ONLY for these accounts.
GMAIL_ALLOWLIST=

# ── Redis (Upstash free tier in prod) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Polling intervals ─────────────────────────────────────────────────────────
GMAIL_POLL_INTERVAL_MINUTES=30
CLASSROOM_POLL_INTERVAL_MINUTES=120
CALENDAR_POLL_INTERVAL_MINUTES=120
WEBSITE_SCRAPE_INTERVAL_MINUTES=360
DIGEST_SEND_TIME=07:30                # HH:MM in IST

# ── Embedding (local sentence-transformers — no API key, no quota) ────────────
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768
